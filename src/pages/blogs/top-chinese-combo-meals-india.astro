---
import Layout from "../../layouts/Layout.astro";
import { Image } from "astro:assets";
import heroImg from "../../assets/LandingImage.jpg";
import BlogImg from "../../assets/blogImages/blog22.webp";

const breadcrumbs = [
    { label: "Home", href: "/" },
    { label: "Blogs", href: "/blogs" },
    { label: "Top Chinese Combo Meals in India", href: "#", current: true }
];

