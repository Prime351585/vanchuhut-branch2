---
<Layout title={blogData.metaTitle} description={blogData.metaDescription}>
    <section class="font-agdasima">
        <Image src={heroImg} class="scale-100 w-screen h-[168px] transform -translate-y-[100px] md:-translate-y-[60px] object-cover" alt="Header Image, shows picture of Various Chinese Food on a Table"/>
    </section> 
    <nav class="flex px-4 mb-4" aria-label="Breadcrumb">
        <ol class="flex items-center space-x-2">
            {breadcrumbs.map((item, index) => (
                <li class="flex items-center">
                    {index > 0 && (
                        <svg class="w-4 h-4 text-gray-400 mx-2" fill="currentColor" viewBox="0 0 20 20">
                            <path fill-rule="evenodd" d="M7.293 14.707a1 1 0 010-1.414L10.586 10 7.293 6.707a1 1 0 011.414-1.414l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414 0z" clip-rule="evenodd"></path>
                        </svg>
                    )}
                    {item.current ? (
                        <span class="text-gray-600" aria-current="page">{item.label}</span>
                    ) : (
                        <a href={item.href} class="text-primary hover:text-primary/80">{item.label}</a>
                    )}
                </li>
            ))}
        </ol>
    </nav>
    
    <main class="max-w-4xl mx-auto px-4 py-8">
        <div class="relative h-[400px] mb-8 rounded-lg overflow-hidden">
            <Image
                format="avif"
                src={blogData.image} 
                alt="Top Chinese combo meals in India at Vanchu Hut"
                class="w-full h-full object-cover"
            />
        </div>

        <article class="max-w-4xl mx-auto px-4 py-8">
            <h1 class="text-4xl font-bold text-primary mb-8">{blogData.title}</h1>
            
            <p class="lead text-xl text-gray-700 mb-4">
                {blogData.introduction}
            </p>
            
            <p class="text-gray-700 mb-8">
                {blogData.overview}
            </p>

            {blogData.sections.map((section, index) => (
                <section class="mb-12">
                    <h2 class="text-2xl font-semibold text-secondary mb-4">{section.title}</h2>
                    
                    {section.content && <p class="text-gray-700 mb-4">{section.content}</p>}
                    
                    {section.points && (
                        <ul class="list-disc pl-6 mt-4 space-y-2 mb-4">
                            {section.points.map((point) => (
                                <li class="text-gray-700">{point}</li>
                            ))}
                        </ul>
                    )}
                    
                    {section.combos && (
                        <div class="space-y-6">
                            {section.combos.map((combo) => (
                                <div class="bg-white p-6 rounded-lg shadow-md border-l-4 border-primary">
                                    <h3 class="text-xl font-semibold text-primary mb-2">{combo.name}</h3>
                                    <p class="text-gray-700 mb-2"><strong>Includes:</strong> {combo.includes}</p>
                                    <p class="text-gray-700 mb-2">{combo.description}</p>
                                    {combo.note && <p class="text-gray-600 italic">{combo.note}</p>}
                                </div>
                            ))}
                        </div>
                    )}
                    
                    {section.pricing && (
                        <div class="overflow-x-auto">
                            <table class="w-full border-collapse border border-gray-300 mb-4">
                                <thead class="bg-gray-100">
                                    <tr>
                                        <th class="border border-gray-300 px-4 py-2 text-left">Combo Type</th>
                                        <th class="border border-gray-300 px-4 py-2 text-left">Price Range (INR)</th>
                                        <th class="border border-gray-300 px-4 py-2 text-left">Dishes Included</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    {section.pricing.map((price) => (
                                        <tr>
                                            <td class="border border-gray-300 px-4 py-2 font-semibold">{price.type}</td>
                                            <td class="border border-gray-300 px-4 py-2">{price.range}</td>
                                            <td class="border border-gray-300 px-4 py-2">{price.includes}</td>
                                        </tr>
                                    ))}
                                </tbody>
                            </table>
                        </div>
                    )}
                    
                    {section.tips && (
                        <ul class="list-disc pl-6 space-y-2">
                            {section.tips.map((tip) => (
                                <li class="text-gray-700">{tip}</li>
                            ))}
                        </ul>
                    )}
                    
                    {section.note && (
                        <p class="text-gray-700 italic bg-gray-50 p-4 rounded-lg mt-4">{section.note}</p>
                    )}
                </section>
            ))}

            <section class="mb-12">
                <h2 class="text-2xl font-semibold text-secondary mb-4">Conclusion</h2>
                <p class="text-gray-700 mb-4">{blogData.conclusion}</p>
                <p class="text-gray-700 font-semibold text-lg">{blogData.cta}</p>
            </section>

            <section class="bg-primary/10 p-6 rounded-lg mb-12">
                <h2 class="text-2xl font-semibold mb-6">Frequently Asked Questions Of Combo Meals in Chinese Restaurants in India</h2>
                {blogData.faqs.map((faq, index) => (
                    <details class="mb-4 bg-white p-4 rounded-lg">
                        <summary class="font-semibold cursor-pointer">Q{index + 1}: {faq.question}</summary>
                        <p class="mt-2 pl-4 text-gray-600"><strong>A{index + 1}:</strong> {faq.answer}</p>
                    </details>
                ))}
            </section>

            <div class="flex justify-center gap-6">
                <a href="/contact" class="bg-primary text-white px-8 py-3 rounded-full hover:bg-primary/90">
                    Contact Us
                </a>
                <a href="/menu" class="bg-secondary text-white px-8 py-3 rounded-full hover:bg-secondary/90">
                    View Menu
                </a>
                <a href="/reservation" class="bg-green-600 text-white px-8 py-3 rounded-full hover:bg-green-700">
                    Reserve Table
                </a>
            </div>
        </article>
    </main>
</Layout>
