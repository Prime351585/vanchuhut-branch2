---
import Layout from '../layouts/Layout.astro';
import FoodSection from '../components/FoodSection.astro'
import HeroSection from '../components/HeroSection.astro'
import {Image} from "astro:assets";
import dividerImage from "../assets/divider.webp"
import DeliverySection from '../components/DeliverySection.astro';
import MenuSection from "../components/MenuSection.astro"
import VideoSection from "../components/VideoSection.astro"
import FindUssection from "../components/FindUssection.astro"
import DineIn from "../components/DineIn.astro"
import "../global.css"
import FoodSlider from '../components/FoodSlider.astro';
import GoogleReview from '../components/GoogleReview.astro';
import Experience from '../components/Experience.astro';

---
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "Restaurant",
  "name": "VANCHU HUT",
  "image": "https://vanchuhut.in/_astro/DineIn.DTOb2J6X_1nEAwW.avif",
  "@id": "https://vanchuhut.in/#restaurant",
  "url": "https://vanchuhut.in/",
  "telephone": "+91 9971135534",
  "priceRange": "₹500",
  "servesCuisine": "Chinese",
  "hasMenu": "https://vanchuhut.in/menu/",
  "acceptsReservations": "false",
  "sameAs": [
    "https://www.facebook.com/vanchuhut",
    "https://www.instagram.com/vanchuhut"
  ],
  "aggregateRating": {
    "@type": "AggregateRating",
    "ratingValue": "4",
    "ratingCount": "756"
  },
  "address": {
    "@type": "PostalAddress",
    "streetAddress": "Santosh Medical Intersection, Block H, Pratap Vihar",
    "addressLocality": "Ghaziabad",
    "addressRegion": "Uttar Pradesh",
    "postalCode": "201009",
    "addressCountry": "IN"
  },
  "geo": {
    "@type": "GeoCoordinates",
    "latitude": 28.647540,
    "longitude": 77.411249
  },
  "openingHoursSpecification": [
    {
      "@type": "OpeningHoursSpecification",
      "dayOfWeek": [
        "Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday", "Sunday"
      ],
      "opens": "12:00",
      "closes": "22:00"
    }
  ]
}
</script>
<Layout title="Vanchu Hut - Best Chinese Restaurant in Pratap Vihar, Ghaziabad | Authentic Chinese Cuisine" description="Discover the best Chinese restaurant in Pratap Vihar, Ghaziabad, at Vanchu Hut. Enjoy authentic Chinese cuisine with family-friendly dining options.">
	<HeroSection/>
	<div class=" flex justify-center items-center h-0 w-auto ">
		<Image id='center-image' src={dividerImage} format="avif" alt='Chowmin' width={250} height={250} class='z-10 ' >
	</div>
	<FoodSection/>
    
	<DeliverySection/>
    <FoodSlider/>
	<MenuSection/>
    <Experience/>
    <VideoSection/>
    <DineIn/>
    <GoogleReview/>
	<FindUssection/>
</Layout>

<script>
    import gsap from "gsap";
    import { ScrollTrigger } from "gsap/ScrollTrigger";

    gsap.registerPlugin(ScrollTrigger);

    gsap.to("#parallax-image", {
        yPercent: 40, // Adjust this value to control the parallax effect
        ease: "none",
        scrollTrigger: {
            trigger: "#parallax-image",
            start: "top bottom", // when the top of the image hits the bottom of the viewport
            end: "bottom top", // when the bottom of the image hits the top of the viewport
            scrub: true, // smooth scrubbing
        }
    });

    gsap.to("#center-image", {
        yPercent: 0, // Adjust this value to control the animation
        ease: "none",
        scrollTrigger: {
            trigger: "#center-image",
            start: "top bottom", // when the top of the image hits the bottom of the viewport
            end: "bottom top", // when the bottom of the image hits the top of the viewport
            scrub: true, // smooth scrubbing
        }
    });

</script>